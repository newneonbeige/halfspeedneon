---
import Base from '../../layouts/Base.astro';
import SeitenKarte from '../../components/SeitenKarte.astro';
import { site, bereiche } from '../../../site.config.mjs';
import { seitenImBereich, breadcrumbs, absolut, seitenUrl } from '../../lib/inhalte.mjs';

export async function getStaticPaths() {
  return bereiche.map((b) => ({ params: { bereich: b.slug }, props: { b } }));
}

const { b } = Astro.props;
const seiten = await seitenImBereich(b.slug);
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `${b.name} – ${site.name}`,
      description: b.intro,
      url: absolut(`/${b.slug}/`),
      mainEntity: { '@type': 'ItemList', itemListElement: seiten.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: absolut(seitenUrl(s)), name: s.data.titel })) },
    },
    breadcrumbs([[site.name, '/'], [b.name, `/${b.slug}/`]]),
  ],
};
---
<Base title={b.name} description={b.intro} jsonLd={ld} akzent={b.farbe}>
  <div class="wrap bereich">
    <header class="kopf">
      <p class="eyebrow">Bereich</p>
      <h1 class="h-xl"><span class="neon">{b.name}</span></h1>
      <p class="lead">{b.intro}</p>
    </header>
    {seiten.length > 0
      ? <ul class="karten">{seiten.map((s) => <SeitenKarte seite={s} />)}</ul>
      : <p class="muted leer">Hier entsteht gerade etwas. Die ersten Seiten erscheinen in Kürze.</p>}
  </div>
</Base>

<style>
  .bereich { padding-top: 56px; }
  .kopf { display: flex; flex-direction: column; gap: 18px; margin-bottom: 48px; }
  .leer { font-size: 19px; }
</style>
