---
import Logo from './Logo.astro';
import { bereiche, NEUERSCHEINUNGEN } from '../../site.config.mjs';
const pfad = Astro.url.pathname;
const links = [...bereiche, NEUERSCHEINUNGEN];
---
<header class="wrap kopf">
  <Logo />
  <nav aria-label="Hauptnavigation">
    {links.map((b) => (
      <a href={`/${b.slug}/`} style={`--akzent:${b.farbe}`} aria-current={pfad.startsWith(`/${b.slug}/`) ? 'page' : undefined}>{b.name}</a>
    ))}
  </nav>
</header>

<style>
  .kopf { padding-top: 24px; padding-bottom: 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line); max-width: none; }
  nav { display: flex; flex-wrap: wrap; gap: 4px; font-weight: 600; font-size: 16px; }
  nav a { padding: 10px 14px; text-decoration: none; border-radius: 999px; color: var(--text-soft); }
  nav a:hover { color: var(--text); background: var(--surface-2); }
  nav a[aria-current='page'] { color: var(--akzent); box-shadow: inset 0 0 0 1px var(--akzent); }
  @media (max-width: 640px) { nav { gap: 0; font-size: 15px; } nav a { padding: 8px 10px; } }
</style>
